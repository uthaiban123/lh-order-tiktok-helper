<%
  const navActive = typeof active === "undefined" ? "" : active;
  const styles = typeof extraStyles === "undefined" ? [] : extraStyles;
  const heading = typeof pageTitle === "undefined" ? title : pageTitle;
  const fallback = typeof navFallback === "undefined" ? "/" : navFallback;
  const bodyClassName = typeof bodyClass === "undefined" ? "" : bodyClass;
  const historyButtons = typeof showHistory === "undefined" ? true : showHistory;
%>
<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <% styles.forEach(function (href) { %>
      <link rel="stylesheet" href="<%= href %>" />
    <% }) %>
    <link rel="stylesheet" href="/shell.css" />
  </head>
  <body class="app-body <%= bodyClassName %>">
    <div class="app">
      <aside class="sidebar" id="sidebar">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">
            <i data-lucide="shopping-bag"></i>
          </span>
          <div class="brand-copy">
            <strong>LH Orders</strong>
            <span>TikTok Helper</span>
          </div>
        </div>

        <p class="nav-label">ภาพรวม</p>
        <a class="side-link <%= navActive === 'dashboard' ? 'active' : '' %>" href="/">
          <i data-lucide="layout-dashboard"></i>
          <span>แดชบอร์ด</span>
        </a>

        <p class="nav-label">รายงาน</p>
        <a class="side-link <%= navActive === 'reports' ? 'active' : '' %>" href="/reports">
          <i data-lucide="chart-column"></i>
          <span>รายงานยอดขาย</span>
        </a>
        <a class="side-link <%= navActive === 'product-count' ? 'active' : '' %>" href="/product-count">
          <i data-lucide="package-search"></i>
          <span>นับจำนวนสินค้า</span>
        </a>

        <p class="nav-label">นำเข้าข้อมูล</p>
        <a class="side-link <%= navActive === 'imports' ? 'active' : '' %>" href="/imports">
          <i data-lucide="upload"></i>
          <span>นำเข้าไฟล์</span>
        </a>
        <a class="side-link <%= navActive === 'product-master' ? 'active' : '' %>" href="/product-master">
          <i data-lucide="boxes"></i>
          <span>Product Master</span>
        </a>
        <a class="side-link <%= navActive === 'price-sync' ? 'active' : '' %>" href="/price-sync">
          <i data-lucide="refresh-cw"></i>
          <span>ซิงค์ราคา</span>
        </a>

        <div class="sidebar-foot">LH Orders</div>
      </aside>

      <div class="main">
        <header class="navbar">
          <button class="menu-toggle" type="button" data-menu-toggle aria-label="เปิดเมนู">
            <i data-lucide="menu"></i>
            <span>เมนู</span>
          </button>
          <h1><%= heading %></h1>
          <% if (historyButtons) { %>
          <div class="navbar-actions">
            <button type="button" data-nav-back data-fallback="<%= fallback %>">
              <i data-lucide="arrow-left"></i>
              <span>ย้อนกลับ</span>
            </button>
            <button type="button" data-nav-forward>
              <span>ไปต่อ</span>
              <i data-lucide="arrow-right"></i>
            </button>
          </div>
          <% } %>
        </header>
        <div class="content">
