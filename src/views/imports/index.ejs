<%- include('../partials/shell-open', { title, active, pageTitle, showHistory: false, extraStyles: ['/imports.css'] }) %>
<section class="imports-page">
  <div class="import-grid">
    <article class="import-card">
      <div class="import-card-head">
        <span class="import-card-icon"><i data-lucide="shopping-cart"></i></span>
        <h3>นำเข้าไฟล์ Order</h3>
      </div>
      <form id="orders-import-form" class="stack-form">
        <label for="orders-file">ไฟล์ Order Export (.xlsx)</label>
        <input id="orders-file" name="file" type="file" accept=".xlsx,.xls" required />
        <input name="uploadedBy" type="hidden" value="web-import" />
        <button type="submit">นำเข้า Orders</button>
      </form>
      <p id="orders-last-result" class="form-feedback">ยังไม่มีการนำเข้าในรอบนี้</p>
    </article>

    <article class="import-card">
      <div class="import-card-head">
        <span class="import-card-icon"><i data-lucide="wallet"></i></span>
        <h3>นำเข้าไฟล์ Income</h3>
      </div>
      <form id="income-import-form" class="stack-form">
        <label for="income-file">ไฟล์ Income / Settlement (.xlsx)</label>
        <input id="income-file" name="file" type="file" accept=".xlsx,.xls" required />
        <input name="uploadedBy" type="hidden" value="web-import" />
        <button type="submit">นำเข้า Income</button>
      </form>
      <p id="income-last-result" class="form-feedback">ยังไม่มีการนำเข้าในรอบนี้</p>
    </article>

    <article class="import-card" id="product-master">
      <div class="import-card-head">
        <span class="import-card-icon"><i data-lucide="boxes"></i></span>
        <h3>นำเข้า Product Master</h3>
      </div>
      <form id="product-master-import-form" class="stack-form">
        <label for="product-master-file">ไฟล์ TikTok Batch Edit Template (.xlsx)</label>
        <input id="product-master-file" name="file" type="file" accept=".xlsx,.xls" required />
        <input name="uploadedBy" type="hidden" value="web-import" />
        <button type="submit">นำเข้า Product Master</button>
      </form>
      <p id="product-master-last-result" class="form-feedback">ยังไม่มีการนำเข้าในรอบนี้</p>
    </article>
  </div>

  <pre id="output" class="imports-output" hidden>รอการทำงาน...</pre>
</section>
<%- include('../partials/shell-close') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/app.js"></script>
  </body>
</html>
